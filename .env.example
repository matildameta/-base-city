# Optional: your own Base RPC (Alchemy/Infura) for higher rate limits.
# Default falls back to the free public https://mainnet.base.org
BASE_RPC_URL=

# Optional: Basescan API key (free) — small bonus data, not required.
BASESCAN_API_KEY=

# Optional: Upstash Redis (free tier) so the city is shared/persisted across
# all visitors instead of resetting on every serverless cold start.
# Create one free at https://upstash.com -> copy REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set after you deploy the app once, e.g. https://base-city.vercel.app
NEXT_PUBLIC_APP_URL=

# Set after you deploy contracts/BaseCityRegistry.sol via Remix (see README)
NEXT_PUBLIC_REGISTRY_ADDRESS=
